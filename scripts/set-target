#!/usr/bin/env python3

"""Publish the chosen backup target to a systemd unit. Runs as root via pkexec."""

import argparse
import os
import re
import subprocess
import sys
import tempfile

TARGET_ENV_PATH = "/etc/backup-history/target.env"
TARGET_DROP_IN_TEMPLATE = "/etc/systemd/system/{unit}.d/10-backup-history-target.conf"
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMCTL_TIMEOUT_SECONDS = 10

SERVICE_PATTERN = re.compile(r"^[A-Za-z0-9_.@:-]+\.service$")
UUID_PATTERN = re.compile(r"^[A-Za-z0-9-]{1,64}$")
MOUNTPOINT_PATTERN = re.compile(r"^/[A-Za-z0-9 _.:@+/-]{0,255}$")
LABEL_PATTERN = re.compile(r"^[A-Za-z0-9 _.:-]{0,64}$")

DROP_IN_BODY = "[Service]\nEnvironmentFile=-{env_path}\n".format(env_path=TARGET_ENV_PATH)


def validate_values(unit, uuid, path, label):
    if len(unit) > 255 or not SERVICE_PATTERN.fullmatch(unit) or "/" in unit:
        raise ValueError("invalid systemd service name")
    if not UUID_PATTERN.fullmatch(uuid):
        raise ValueError("invalid filesystem UUID")
    if path and not MOUNTPOINT_PATTERN.fullmatch(path):
        raise ValueError("invalid mountpoint")
    if ".." in path.split("/"):
        raise ValueError("mountpoint must not contain a parent reference")
    if not LABEL_PATTERN.fullmatch(label):
        raise ValueError("invalid disk label")
    return {"unit": unit, "uuid": uuid, "path": path, "label": label}


def _write_atomic(destination, text):
    directory = os.path.dirname(destination)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=directory, prefix=".backup-history-")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as temporary_file:
            temporary_file.write(text)
            temporary_file.flush()
            os.fsync(temporary_file.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, destination)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def write_target(root, unit, uuid, path, label):
    _write_atomic(
        root + TARGET_ENV_PATH,
        "# Written by backup-history. Edits are overwritten.\n"
        f"BACKUP_TARGET_UUID={uuid}\n"
        f"BACKUP_TARGET_PATH={path}\n"
        f"BACKUP_TARGET_LABEL={label}\n",
    )
    _write_atomic(root + TARGET_DROP_IN_TEMPLATE.format(unit=unit), DROP_IN_BODY)


def clear_target(root, unit):
    try:
        os.unlink(root + TARGET_ENV_PATH)
    except FileNotFoundError:
        pass

    drop_in = root + TARGET_DROP_IN_TEMPLATE.format(unit=unit)
    try:
        with open(drop_in, "r", encoding="utf-8") as drop_in_file:
            owned_by_us = drop_in_file.read() == DROP_IN_BODY
    except FileNotFoundError:
        owned_by_us = False

    if owned_by_us:
        try:
            os.unlink(drop_in)
        except FileNotFoundError:
            pass


def unit_exists(unit):
    result = subprocess.run(
        [SYSTEMCTL, "cat", "--", unit],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=SYSTEMCTL_TIMEOUT_SECONDS,
    )
    return result.returncode == 0


def daemon_reload():
    subprocess.run(
        [SYSTEMCTL, "daemon-reload"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=SYSTEMCTL_TIMEOUT_SECONDS,
        check=True,
    )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--unit", required=True)
    parser.add_argument("--uuid", default="")
    parser.add_argument("--path", default="")
    parser.add_argument("--label", default="")
    parser.add_argument("--clear", action="store_true")
    arguments = parser.parse_args()

    try:
        if arguments.clear:
            validate_values(arguments.unit, "0", "/", "")
            clear_target("", arguments.unit)
        else:
            values = validate_values(
                arguments.unit, arguments.uuid, arguments.path, arguments.label
            )
            if not unit_exists(values["unit"]):
                raise ValueError("systemd unit not found")
            write_target(
                "", values["unit"], values["uuid"], values["path"], values["label"]
            )
        daemon_reload()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(str(error)[:256], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
