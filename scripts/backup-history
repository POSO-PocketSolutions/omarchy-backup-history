#!/usr/bin/env python3

import argparse
import ctypes
import json
import os
import re
import selectors
import signal
import subprocess
import time
from datetime import date, datetime, timedelta, timezone


SUCCESS_MESSAGE_ID = "39f53479d3a045ac8e11786248231fbf"
FAILURE_MESSAGE_ID = "be02cf6855d2428ba40df7e9d022f03d"

MAX_WEEKS = 12
MAX_DAYS = MAX_WEEKS * 7
MAX_SERVICE_LENGTH = 255
SERVICE_PATTERN = re.compile(r"^[A-Za-z0-9_.@:-]+\.service$")
SESSION_TOKEN_PATTERN = re.compile(r"^[a-f0-9-]{16,128}$")
SESSION_TOKEN_ENV = "BACKUP_HISTORY_SESSION_TOKEN"
JOURNAL_MAX_RECORDS = 4096
JOURNAL_MAX_BYTES = 1024 * 1024
SYSTEMCTL_MAX_BYTES = 16 * 1024
STDERR_MAX_BYTES = 8 * 1024
JSON_MAX_BYTES = 64 * 1024
ERROR_MAX_CHARS = 256
JOURNAL_TIMEOUT_SECONDS = 5.0
SYSTEMCTL_TIMEOUT_SECONDS = 2.0
TERM_GRACE_SECONDS = 0.5
POST_KILL_WAIT_SECONDS = 0.5
READ_CHUNK_BYTES = 64 * 1024

TARGET_ENV_PATH = "/etc/backup-history/target.env"
TARGET_DROP_IN_TEMPLATE = "/etc/systemd/system/{unit}.d/10-backup-history-target.conf"
TARGET_ENV_MAX_BYTES = 8 * 1024
UUID_PATTERN = re.compile(r"^[A-Za-z0-9-]{1,64}$")
MOUNTPOINT_PATTERN = re.compile(r"^/[^\0\n]{0,255}$")
LABEL_PATTERN = re.compile(r"^[A-Za-z0-9 _.:-]{0,64}$")
TARGET_ENV_KEYS = {
    "BACKUP_TARGET_UUID": ("uuid", UUID_PATTERN),
    "BACKUP_TARGET_PATH": ("path", MOUNTPOINT_PATTERN),
    "BACKUP_TARGET_LABEL": ("label", LABEL_PATTERN),
}

MAX_DISKS = 32
LSBLK_TIMEOUT_SECONDS = 3.0
LSBLK_MAX_BYTES = 256 * 1024
MAX_SERVICES = 64

PR_SET_PDEATHSIG = 1
_LIBC = ctypes.CDLL(None, use_errno=True)
_ACTIVE_PROCESS = None
_SIGNALS_BLOCKED_DURING_SPAWN = {signal.SIGTERM, signal.SIGINT}


class BoundedProcessError(RuntimeError):
    """An external command exceeded its bounds or exited unsuccessfully."""


class ProcessDeadlineExceeded(BoundedProcessError):
    pass


class ProcessOutputLimitExceeded(BoundedProcessError):
    pass


class ProcessRecordLimitExceeded(BoundedProcessError):
    pass


def _prepare_child(expected_parent, parent_signal_mask):
    if _LIBC.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
        os._exit(127)
    if os.getppid() != expected_parent:
        os.kill(os.getpid(), signal.SIGKILL)
    signal.pthread_sigmask(signal.SIG_SETMASK, parent_signal_mask)


def establish_backend_session():
    """Make this process the leader of the session QML will clean up by PID."""
    process_id = os.getpid()
    if os.getsid(0) != process_id:
        os.setsid()
    if os.getsid(0) != process_id:
        raise OSError("unable to establish isolated backend session")


def _process_state(pid):
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as process_stat:
            fields = process_stat.read().rpartition(")")[2].split()
    except (OSError, IndexError):
        return None
    return fields[0] if fields else None


def _process_group_has_live_members(process_group_id):
    try:
        entries = os.scandir("/proc")
    except OSError:
        return True

    with entries:
        for entry in entries:
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            try:
                if os.getpgid(pid) == process_group_id and _process_state(pid) != "Z":
                    return True
            except (ProcessLookupError, PermissionError):
                continue
    return False


def terminate_process_group(
    process,
    grace_seconds=TERM_GRACE_SECONDS,
    post_kill_wait_seconds=POST_KILL_WAIT_SECONDS,
):
    """Terminate a command group while its unreaped leader pins the PGID."""
    if process.returncode is not None:
        return True

    process_group_id = process.pid
    if _process_group_has_live_members(process_group_id):
        try:
            os.killpg(process_group_id, signal.SIGTERM)
        except ProcessLookupError:
            pass

        deadline = time.monotonic() + grace_seconds
        while _process_group_has_live_members(process_group_id) and time.monotonic() < deadline:
            time.sleep(0.01)

        if _process_group_has_live_members(process_group_id):
            try:
                os.killpg(process_group_id, signal.SIGKILL)
            except ProcessLookupError:
                pass

        kill_deadline = time.monotonic() + post_kill_wait_seconds
        while _process_group_has_live_members(process_group_id) and time.monotonic() < kill_deadline:
            time.sleep(0.01)

    group_stopped = not _process_group_has_live_members(process_group_id)
    try:
        process.wait(timeout=post_kill_wait_seconds)
    except subprocess.TimeoutExpired:
        return False
    return group_stopped


def _wait_without_reaping(process, timeout_seconds):
    deadline = time.monotonic() + timeout_seconds
    flags = os.WEXITED | os.WNOHANG | os.WNOWAIT
    while True:
        result = os.waitid(os.P_PID, process.pid, flags)
        if result is not None:
            if result.si_code == os.CLD_EXITED:
                return result.si_status
            if result.si_code in {os.CLD_KILLED, os.CLD_DUMPED}:
                return -result.si_status
            raise BoundedProcessError("external command returned an unsupported wait status")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(process.args, timeout_seconds)
        time.sleep(min(0.01, remaining))


def _signal_handler(signum, _frame):
    process = _ACTIVE_PROCESS
    if process is not None:
        terminate_process_group(process)
    raise SystemExit(128 + signum)


def install_signal_handlers():
    signal.signal(signal.SIGTERM, _signal_handler)
    signal.signal(signal.SIGINT, _signal_handler)


def _close_stream(selector, stream):
    if stream is None:
        return
    try:
        selector.unregister(stream)
    except (KeyError, ValueError):
        pass
    try:
        stream.close()
    except OSError:
        pass


def _bounded_error_text(value):
    text = " ".join(str(value).splitlines()).strip()
    return text[:ERROR_MAX_CHARS] or "external command failed"


def bounded_run(
    *args,
    timeout_seconds,
    max_stdout_bytes,
    max_stderr_bytes=STDERR_MAX_BYTES,
    max_records=None,
):
    """Run a command with bounded pipes, deadline, group teardown, and reaping."""
    global _ACTIVE_PROCESS

    expected_parent = os.getpid()
    previous_signal_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK,
        _SIGNALS_BLOCKED_DURING_SPAWN,
    )
    process = None
    try:
        process = subprocess.Popen(
            args,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            process_group=0,
            preexec_fn=lambda: _prepare_child(expected_parent, previous_signal_mask),
        )
        _ACTIVE_PROCESS = process
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_signal_mask)

    selector = selectors.DefaultSelector()
    stdout = bytearray()
    stderr = bytearray()
    stdout_records = 0
    deadline = time.monotonic() + timeout_seconds

    try:
        selector.register(process.stdout, selectors.EVENT_READ, "stdout")
        selector.register(process.stderr, selectors.EVENT_READ, "stderr")

        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ProcessDeadlineExceeded(
                    f"{os.path.basename(args[0])} exceeded {timeout_seconds:g}s deadline"
                )

            events = selector.select(timeout=min(0.1, remaining))
            if not events:
                continue

            for key, _mask in events:
                chunk = os.read(key.fd, READ_CHUNK_BYTES)
                if not chunk:
                    _close_stream(selector, key.fileobj)
                    continue

                if key.data == "stdout":
                    if len(stdout) + len(chunk) > max_stdout_bytes:
                        raise ProcessOutputLimitExceeded(
                            f"{os.path.basename(args[0])} exceeded {max_stdout_bytes} stdout bytes"
                        )
                    stdout_records += chunk.count(b"\n")
                    if max_records is not None and stdout_records > max_records:
                        raise ProcessRecordLimitExceeded(
                            f"{os.path.basename(args[0])} exceeded {max_records} records"
                        )
                    stdout.extend(chunk)
                else:
                    if len(stderr) + len(chunk) > max_stderr_bytes:
                        raise ProcessOutputLimitExceeded(
                            f"{os.path.basename(args[0])} exceeded {max_stderr_bytes} stderr bytes"
                        )
                    stderr.extend(chunk)

        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise ProcessDeadlineExceeded(
                f"{os.path.basename(args[0])} exceeded {timeout_seconds:g}s deadline"
            )
        try:
            return_code = _wait_without_reaping(process, remaining)
        except subprocess.TimeoutExpired as error:
            raise ProcessDeadlineExceeded(
                f"{os.path.basename(args[0])} exceeded {timeout_seconds:g}s deadline"
            ) from error

        if return_code != 0:
            detail = _bounded_error_text(stderr.decode("utf-8", errors="replace"))
            raise BoundedProcessError(
                f"{os.path.basename(args[0])} exited with status {return_code}: {detail}"
            )
        return stdout.decode("utf-8", errors="strict")
    except BaseException:
        terminate_process_group(process)
        raise
    finally:
        _close_stream(selector, process.stdout)
        _close_stream(selector, process.stderr)
        selector.close()
        terminate_process_group(process)
        _ACTIVE_PROCESS = None


def validate_session_token(token):
    if token and not SESSION_TOKEN_PATTERN.fullmatch(token):
        raise ValueError("invalid session cleanup token")
    return token


def validate_service(service):
    if len(service) > MAX_SERVICE_LENGTH or not SERVICE_PATTERN.fullmatch(service):
        raise ValueError("invalid systemd service name")
    return service


def parse_target_env(text):
    target = {"uuid": "", "path": "", "label": ""}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        entry = TARGET_ENV_KEYS.get(key.strip())
        if not entry:
            continue
        name, pattern = entry
        value = value.strip()
        if pattern.fullmatch(value):
            target[name] = value
    return target


def read_target_env(path=TARGET_ENV_PATH):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as env_file:
            text = env_file.read(TARGET_ENV_MAX_BYTES)
    except OSError:
        return {"uuid": "", "path": "", "label": ""}
    return parse_target_env(text)


def _flatten_block_devices(nodes):
    for node in nodes:
        yield node
        for child in _flatten_block_devices(node.get("children") or []):
            yield child


def parse_disks(text, root_source=""):
    document = json.loads(text)
    disks = []
    for node in _flatten_block_devices(document.get("blockdevices") or []):
        uuid = node.get("uuid") or ""
        fstype = node.get("fstype") or ""
        if not uuid or not fstype or not UUID_PATTERN.fullmatch(uuid):
            continue
        if root_source and root_source.endswith("/" + str(node.get("name", ""))):
            continue
        disks.append({
            "uuid": uuid,
            "label": node.get("label") or "",
            "size": node.get("size") or "",
            "fstype": fstype,
            "mountpoint": node.get("mountpoint") or "",
            "removable": bool(node.get("rm")),
        })
        if len(disks) >= MAX_DISKS:
            break
    return disks


def _root_source():
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8", errors="replace") as mounts:
            for line in mounts:
                fields = line.split(" - ")
                if len(fields) < 2:
                    continue
                if fields[0].split()[4] == "/":
                    return fields[1].split()[1]
    except (OSError, IndexError):
        return ""
    return ""


def discover_disks():
    output = bounded_run(
        "lsblk",
        "-J",
        "-o",
        "NAME,UUID,LABEL,SIZE,FSTYPE,MOUNTPOINT,RM,TYPE",
        timeout_seconds=LSBLK_TIMEOUT_SECONDS,
        max_stdout_bytes=LSBLK_MAX_BYTES,
    )
    return parse_disks(output, _root_source())


def parse_services(text, configured=""):
    document = json.loads(text)
    services = []
    seen = set()
    if configured and SERVICE_PATTERN.fullmatch(configured):
        services.append({"unit": configured, "state": "unknown", "exists": False})
        seen.add(configured)
    for entry in document:
        unit = str(entry.get("unit", ""))
        if unit in seen or not SERVICE_PATTERN.fullmatch(unit):
            continue
        seen.add(unit)
        services.append({
            "unit": unit,
            "state": str(entry.get("active", "unknown")),
            "exists": True,
        })
        if len(services) >= MAX_SERVICES:
            break
    if configured and services and services[0]["unit"] == configured:
        for entry in document:
            if str(entry.get("unit", "")) == configured:
                services[0] = {
                    "unit": configured,
                    "state": str(entry.get("active", "unknown")),
                    "exists": True,
                }
                break
    return services


def discover_services(configured=""):
    output = bounded_run(
        "systemctl",
        "list-units",
        "--type=service",
        "--all",
        "--no-legend",
        "--no-pager",
        "--output=json",
        timeout_seconds=SYSTEMCTL_TIMEOUT_SECONDS,
        max_stdout_bytes=LSBLK_MAX_BYTES,
    )
    return parse_services(output, configured)


def parse_events(lines, local_timezone=None):
    events = {}
    zone = local_timezone or datetime.now().astimezone().tzinfo
    for line in lines:
        if not line.strip():
            continue
        entry = json.loads(line)
        message_id = entry.get("MESSAGE_ID")
        if message_id not in {SUCCESS_MESSAGE_ID, FAILURE_MESSAGE_ID}:
            continue
        timestamp = datetime.fromtimestamp(
            int(entry["__REALTIME_TIMESTAMP"]) / 1_000_000,
            timezone.utc,
        ).astimezone(zone)
        status = "success" if message_id == SUCCESS_MESSAGE_ID else "failed"
        day = timestamp.date()
        if day not in events or timestamp > events[day]["timestamp"]:
            events[day] = {"status": status, "timestamp": timestamp}
    return events


def build_calendar(events, weeks, today=None):
    current = today or date.today()
    days_since_sunday = (current.weekday() + 1) % 7
    start = current - timedelta(days=days_since_sunday + (weeks - 1) * 7)
    days = []
    cursor = start
    while cursor <= current:
        event = events.get(cursor)
        days.append({
            "date": cursor.isoformat(),
            "weekday": (cursor.weekday() + 1) % 7,
            "status": event["status"] if event else "none",
            "timestamp": event["timestamp"].isoformat() if event else None,
            "today": cursor == current,
        })
        cursor += timedelta(days=1)
    return days


def service_state(service):
    output = bounded_run(
        "systemctl",
        "show",
        service,
        "-p",
        "ActiveState",
        "-p",
        "SubState",
        "-p",
        "Result",
        timeout_seconds=SYSTEMCTL_TIMEOUT_SECONDS,
        max_stdout_bytes=SYSTEMCTL_MAX_BYTES,
    )
    properties = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    active = properties.get("ActiveState", "unknown")
    substate = properties.get("SubState", "unknown")
    if active == "activating" and substate != "auto-restart":
        return "running"
    if properties.get("Result") != "success":
        return "failed"
    return "idle"


def collect(service, weeks):
    service = validate_service(service)
    today = date.today()
    start = today - timedelta(days=weeks * 7)
    output = bounded_run(
        "journalctl",
        "-u",
        service,
        "--since",
        start.isoformat(),
        "--output=json",
        "--output-fields=MESSAGE_ID,__REALTIME_TIMESTAMP",
        "--lines",
        str(JOURNAL_MAX_RECORDS + 1),
        "--no-pager",
        f"MESSAGE_ID={SUCCESS_MESSAGE_ID}",
        f"MESSAGE_ID={FAILURE_MESSAGE_ID}",
        timeout_seconds=JOURNAL_TIMEOUT_SECONDS,
        max_stdout_bytes=JOURNAL_MAX_BYTES,
        max_records=JOURNAL_MAX_RECORDS,
    )
    events = parse_events(output.splitlines())
    days = build_calendar(events, weeks, today)
    latest = max(events.values(), key=lambda event: event["timestamp"]) if events else None
    successful = [event for event in events.values() if event["status"] == "success"]
    latest_success = max(successful, key=lambda event: event["timestamp"]) if successful else None
    return {
        "service": service,
        "state": service_state(service),
        "days": days,
        "summary": {
            "success": sum(day["status"] == "success" for day in days),
            "failed": sum(day["status"] == "failed" for day in days),
            "missing": sum(day["status"] == "none" for day in days),
        },
        "latest": {
            "status": latest["status"],
            "timestamp": latest["timestamp"].isoformat(),
        } if latest else None,
        "latestSuccess": {
            "timestamp": latest_success["timestamp"].isoformat(),
        } if latest_success else None,
    }


def encode_payload(payload):
    if "error" in payload:
        payload = dict(payload)
        payload["error"] = _bounded_error_text(payload["error"])
    encoded = json.dumps(payload, ensure_ascii=True, separators=(",", ":")).encode("ascii")
    if len(encoded) <= JSON_MAX_BYTES:
        return encoded.decode("ascii")

    fallback = {
        "service": str(payload.get("service", ""))[:MAX_SERVICE_LENGTH],
        "state": "unknown",
        "days": [],
        "error": "backend JSON payload exceeded size limit",
    }
    return json.dumps(fallback, ensure_ascii=True, separators=(",", ":"))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--service", default="restic-backup.service")
    parser.add_argument("--weeks", type=int, default=4)
    parser.add_argument("--session-token", default="")
    args = parser.parse_args()
    service = str(args.service)[:MAX_SERVICE_LENGTH]

    install_signal_handlers()
    try:
        session_token = validate_session_token(args.session_token)
        if session_token:
            os.environ[SESSION_TOKEN_ENV] = session_token
        establish_backend_session()
        service = validate_service(args.service)
        payload = collect(service, max(2, min(args.weeks, MAX_WEEKS)))
    except (
        BoundedProcessError,
        OSError,
        UnicodeError,
        ValueError,
        KeyError,
        json.JSONDecodeError,
    ) as error:
        payload = {
            "service": service,
            "state": "unknown",
            "days": [],
            "error": _bounded_error_text(error),
        }
    print(encode_payload(payload))


if __name__ == "__main__":
    main()
